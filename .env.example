# ---------------------------------------------------------------------------
# Template. Copy to .env and fill in. NEVER put real secrets in this file --
# this one IS committed to git. The real .env is ignored (see .gitignore).
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Databricks -------------------------------------------------------------
# Workspace URL, no trailing slash.
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
# Numeric workspace id (the "o=" value in the workspace URL).
DATABRICKS_WORKSPACE_ID=
# Account id (GUID) from the account console.
DATABRICKS_ACCOUNT_ID=
# Cloud + region. MUST match Snowflake's, or the comparison is void.
DATABRICKS_CLOUD=aws
DATABRICKS_REGION=
# Personal access token OR leave blank and use OAuth via `databricks auth login`.
DATABRICKS_TOKEN=
# SQL warehouse HTTP path, e.g. /sql/1.0/warehouses/abc123 -- filled in Phase 1.
DATABRICKS_HTTP_PATH=

# --- Snowflake --------------------------------------------------------------
# Account identifier in ORG-ACCOUNT form.
# Cloud + region. MUST match Databricks'.

# --- Project ----------------------------------------------------------------
# Trial end dates, so we know how long the clocks have left (YYYY-MM-DD).
DATABRICKS_TRIAL_ENDS=
